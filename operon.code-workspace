{
  "folders": [
    {
      "name": "..",
      "path": "."
    },
    {
      "name": "core",
      "path": "core"
    },
    {
      "name": "console",
      "path": "console"
    },
    {
      "name": "docs",
      "path": "docs"
    },
    {
      "name": ".operon",
      "path": "../../.operon"
    }
  ],
  "settings": {
    "git.autorefresh": true,
    "git.autoStash": true,
    "search.exclude": {
      "**/target": true,
      "**/node_modules": true,
      "**/dist": true,
      "**/.git": true
    },
    "files.watcherExclude": {
      "**/target/**": true,
      "**/node_modules/**": true,
      "**/dist/**": true
    }
  }
}
