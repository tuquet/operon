{
  "folders": [
    {
      "name": "Workspace Root",
      "path": "."
    },
    {
      "name": "Core (Rust)",
      "path": "core"
    },
    {
      "name": "Console (Web & Desktop)",
      "path": "console"
    },
    {
      "name": "Docs",
      "path": "docs"
    }
  ],
  "settings": {
    "git.autorefresh": true,
    "git.autoStash": true,
    "search.exclude": {
      "**/target": true,
      "**/node_modules": true,
      "**/dist": true,
      "**/.git": true
    },
    "files.watcherExclude": {
      "**/target/**": true,
      "**/node_modules/**": true,
      "**/dist/**": true
    }
  }
}
