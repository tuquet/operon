# ==============================================================================
# OPERON AUTOMATION DAEMON - ENVIRONMENT CONFIGURATION TEMPLATE (.env.example)
# ==============================================================================
# Architecture: High-Performance Rust Automation Engine connected to Central ID
# ==============================================================================

# Loopback Daemon API & WebSocket Bridge
DAEMON_HOST=127.0.0.1
DAEMON_PORT=8765

# ------------------------------------------------------------------------------
# Central ID SSOT (Supabase Auth & Database REST)
# ------------------------------------------------------------------------------
# Development: http://127.0.0.1:55321
# Production:  https://id.tuquet.com
SUPABASE_URL=http://127.0.0.1:55321
SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.eyJpc3MiOiJzdXBhYmFzZS1kZW1vIiwicm9sZSI6ImFub24iLCJleHAiOjE5ODM4MTI5OTZ9.CRXP1A7WOeoJeXxjNni43kdQwgnWNReilDMblYTn_I0

# ------------------------------------------------------------------------------
# Desktop Gateway Proxy Integration
# ------------------------------------------------------------------------------
GATEWAY_SOCKS_PORT=1080
GATEWAY_HTTP_PORT=8118

# Log level: error, warn, info, debug, trace
RUST_LOG=info
RUST_BACKTRACE=1

# Optional: Data Directory (Default: ~/.operon)
DATA_DIR=

# Optional: Telemetry Crash Reporting
SENTRY_DSN=

# ------------------------------------------------------------------------------
# Docker Compose (Web Console, Build Proxy, Optional Bugsink Profile)
# ------------------------------------------------------------------------------
VITE_PORT=5666
VITE_TURNSTILE_SITE_KEY=1x00000000000000000000AA
VITE_BUGSINK_DSN=
BUILD_HTTP_PROXY=
BUILD_HTTPS_PROXY=

# Optional Bugsink tracker (`docker compose --profile telemetry up -d`)
BUGSINK_PORT=8000
BUGSINK_SECRET_KEY=<GENERATE_RANDOM_50_CHARS>
BUGSINK_ADMIN_CREDENTIALS=admin@operon.local:admin123456
