{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "local: <cli> dev",
      "type": "shell",
      "command": "cargo",
      "args": ["run", "--bin", "opn"],
      "isBackground": true,
      "group": {
        "kind": "build",
        "isDefault": true
      },
      "presentation": {
        "reveal": "always",
        "panel": "shared",
        "clear": true
      },
      "problemMatcher": []
    },
    {
      "label": "local: <cli> install",
      "type": "shell",
      "command": "cargo",
      "args": ["install", "--path", "crates/cli", "--bin", "opn", "--debug", "--force", "--root", "${userHome}/.operon"],
      "presentation": {
        "reveal": "always",
        "panel": "shared",
        "clear": true
      },
      "problemMatcher": ["$rustc"]
    },
    {
      "label": "local: <cli> check",
      "type": "shell",
      "command": "cargo",
      "args": ["check", "--bin", "opn"],
      "presentation": {
        "reveal": "always",
        "panel": "shared",
        "clear": true
      },
      "problemMatcher": ["$rustc"]
    },
    {
      "label": "local: <cli> test",
      "type": "shell",
      "command": "cargo",
      "args": ["test", "-p", "operon"],
      "presentation": {
        "reveal": "always",
        "panel": "shared",
        "clear": true
      },
      "problemMatcher": ["$rustc"]
    }
  ]
}
