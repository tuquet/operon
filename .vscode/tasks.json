{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "[rust] dev install (opn)",
      "detail": "Biên dịch nhanh bản debug và cài trực tiếp vào cargo bin/PATH bằng cargo install.",
      "type": "shell",
      "command": "cargo install --path crates/cli --debug --locked --force",
      "group": {
        "kind": "build",
        "isDefault": true
      },
      "problemMatcher": ["$rustc"],
      "presentation": {
        "echo": true,
        "reveal": "always",
        "focus": false,
        "panel": "shared",
        "clear": false
      }
    },
    {
      "label": "[rust] check workspace",
      "detail": "Kiểm tra kiểu và biên dịch nhanh toàn bộ workspace (cli, worker, browser, faker).",
      "type": "shell",
      "command": "cargo check --workspace",
      "group": "build",
      "problemMatcher": ["$rustc"],
      "presentation": {
        "echo": true,
        "reveal": "always",
        "panel": "shared"
      }
    },
    {
      "label": "[rust] test workspace",
      "detail": "Chạy toàn bộ unit tests trên tất cả các crate trong Cargo workspace.",
      "type": "shell",
      "command": "cargo test --workspace",
      "group": {
        "kind": "test",
        "isDefault": true
      },
      "problemMatcher": ["$rustc"],
      "presentation": {
        "echo": true,
        "reveal": "always",
        "panel": "shared"
      }
    },
    {
      "label": "[rust] test cli (operon)",
      "detail": "Chạy unit test và contract verification cho crate operon (crates/cli).",
      "type": "shell",
      "command": "cargo test -p operon --lib",
      "group": "test",
      "problemMatcher": ["$rustc"],
      "presentation": {
        "echo": true,
        "reveal": "always",
        "panel": "shared"
      }
    },
    {
      "label": "[rust] test worker",
      "detail": "Chạy unit test cho crate worker (crates/worker).",
      "type": "shell",
      "command": "cargo test -p worker --lib",
      "group": "test",
      "problemMatcher": ["$rustc"],
      "presentation": {
        "echo": true,
        "reveal": "always",
        "panel": "shared"
      }
    },
    {
      "label": "[cloud] supabase start",
      "detail": "Khởi động local Supabase stack (PostgreSQL, Auth, Storage, Edge Runtime).",
      "type": "shell",
      "command": "supabase start",
      "problemMatcher": [],
      "options": {
        "cwd": "${workspaceFolder}/cloud"
      },
      "presentation": {
        "echo": true,
        "reveal": "always",
        "panel": "shared"
      }
    },
    {
      "label": "[cloud] supabase stop",
      "detail": "Dừng toàn bộ container Supabase local đang chạy.",
      "type": "shell",
      "command": "supabase stop",
      "problemMatcher": [],
      "options": {
        "cwd": "${workspaceFolder}/cloud"
      },
      "presentation": {
        "echo": true,
        "reveal": "always",
        "panel": "shared"
      }
    },
    {
      "label": "[cloud] supabase db reset",
      "detail": "Reset database local và migrate lại toàn bộ schema từ đầu.",
      "type": "shell",
      "command": "supabase db reset",
      "problemMatcher": [],
      "options": {
        "cwd": "${workspaceFolder}/cloud"
      },
      "presentation": {
        "echo": true,
        "reveal": "always",
        "panel": "shared"
      }
    },
    {
      "label": "[cloud] supabase db reset (linked)",
      "detail": "Reset remote Supabase linked database qua Gateway proxy và migrate schema/plugins.",
      "type": "shell",
      "command": "supabase db reset --linked",
      "problemMatcher": [],
      "options": {
        "cwd": "${workspaceFolder}/cloud"
      },
      "presentation": {
        "echo": true,
        "reveal": "always",
        "panel": "shared"
      }
    },
    {
      "label": "[cloud] test db (all 11 suites)",
      "detail": "Chạy trực quan toàn bộ 11 test suites kiểm thử tính toàn vẹn DB Supabase (Core IAM, Plugins, RLS, RBAC).",
      "type": "shell",
      "command": "powershell -ExecutionPolicy Bypass -File scripts/test_db.ps1 -Target local",
      "group": {
        "kind": "test",
        "isDefault": false
      },
      "problemMatcher": [],
      "options": {
        "cwd": "${workspaceFolder}/cloud"
      },
      "presentation": {
        "echo": true,
        "reveal": "always",
        "focus": true,
        "panel": "shared",
        "clear": true
      }
    },
    {
      "label": "[cloud] test db (specific suite)",
      "detail": "Chạy trực quan 1 test suite cụ thể (01_iam, 09_rls, 10_rbac, 04_subscriptions, 08_commerce...).",
      "type": "shell",
      "command": "powershell -ExecutionPolicy Bypass -File scripts/test_db.ps1 -Target local -SpecificTest '${input:testSuiteName}'",
      "group": "test",
      "problemMatcher": [],
      "options": {
        "cwd": "${workspaceFolder}/cloud"
      },
      "presentation": {
        "echo": true,
        "reveal": "always",
        "focus": true,
        "panel": "shared",
        "clear": true
      }
    },
    {
      "label": "[cloud] reset & test db (local)",
      "detail": "Reset sạch DB local, áp dụng plugins & seeds rồi chạy toàn bộ 11 test suites.",
      "type": "shell",
      "command": "supabase db reset --local && powershell -ExecutionPolicy Bypass -File scripts/plugins/apply_plugins.ps1 -Target local && powershell -ExecutionPolicy Bypass -File scripts/test_db.ps1 -Target local",
      "group": "test",
      "problemMatcher": [],
      "options": {
        "cwd": "${workspaceFolder}/cloud"
      },
      "presentation": {
        "echo": true,
        "reveal": "always",
        "focus": true,
        "panel": "shared",
        "clear": true
      }
    },
    {
      "label": "[web] console dev",
      "detail": "Khởi động Vite dev server cho ứng dụng OperonConsole / Workstation.",
      "type": "shell",
      "command": "pnpm dev",
      "problemMatcher": [],
      "options": {
        "cwd": "${workspaceFolder}/console"
      },
      "isBackground": true,
      "presentation": {
        "echo": true,
        "reveal": "always",
        "panel": "shared"
      }
    },
    {
      "label": "[tauri] dev (desktop workstation)",
      "detail": "Khởi động môi trường desktop development (Vite Hot-Reload + Rust Tauri v2 core).",
      "type": "shell",
      "command": "pnpm run tauri:dev",
      "problemMatcher": ["$rustc"],
      "options": {
        "cwd": "${workspaceFolder}/console"
      },
      "isBackground": true,
      "presentation": {
        "echo": true,
        "reveal": "always",
        "panel": "shared"
      }
    },
    {
      "label": "[tauri] check (src-tauri)",
      "detail": "Kiểm tra cú pháp và loại trừ lỗi biên dịch Rust cho crate src-tauri.",
      "type": "shell",
      "command": "cargo check",
      "problemMatcher": ["$rustc"],
      "options": {
        "cwd": "${workspaceFolder}/console/apps/workstation/src-tauri"
      },
      "group": "build",
      "presentation": {
        "echo": true,
        "reveal": "always",
        "panel": "shared"
      }
    },
    {
      "label": "[web] docs dev",
      "detail": "Khởi động VitePress dev server cho cổng tài liệu docs.",
      "type": "shell",
      "command": "pnpm dev",
      "problemMatcher": [],
      "options": {
        "cwd": "${workspaceFolder}/docs"
      },
      "isBackground": true,
      "presentation": {
        "echo": true,
        "reveal": "always",
        "panel": "shared"
      }
    },
    {
      "label": "[infra] docker compose up (core)",
      "detail": "Khởi động các dịch vụ cốt lõi (daemon, console) bằng Docker Compose.",
      "type": "shell",
      "command": "docker compose up -d",
      "problemMatcher": [],
      "presentation": {
        "echo": true,
        "reveal": "always",
        "panel": "shared"
      }
    },
    {
      "label": "[infra] docker compose down",
      "detail": "Dừng và dọn dẹp các container Docker Compose.",
      "type": "shell",
      "command": "docker compose down",
      "problemMatcher": [],
      "presentation": {
        "echo": true,
        "reveal": "always",
        "panel": "shared"
      }
    },
    {
      "label": "[infra] tunnel on (socks5 + http)",
      "detail": "Khởi động background tunnel (SOCKS5 1080 qua my-vps-cf và HTTP forwarder 8118).",
      "type": "shell",
      "command": "tunnel on",
      "problemMatcher": [],
      "presentation": {
        "echo": true,
        "reveal": "always",
        "panel": "shared"
      }
    },
    {
      "label": "[infra] tunnel off",
      "detail": "Dừng toàn bộ background tunnel (1080 và 8118).",
      "type": "shell",
      "command": "tunnel off",
      "problemMatcher": [],
      "presentation": {
        "echo": true,
        "reveal": "always",
        "panel": "shared"
      }
    },
    {
      "label": "[infra] tunnel status",
      "detail": "Kiểm tra trạng thái cổng 1080/8118 và IP egress ngoại mạng.",
      "type": "shell",
      "command": "tunnel status",
      "problemMatcher": [],
      "presentation": {
        "echo": true,
        "reveal": "always",
        "panel": "shared"
      }
    }
  ],
  "inputs": [
    {
      "id": "testSuiteName",
      "type": "pickString",
      "description": "Chọn Test Suite DB muốn chạy:",
      "options": [
        "01_verify_core_iam",
        "02_verify_automation_plugin",
        "03_verify_browsers_plugin",
        "03_verify_storage_plugin",
        "04_verify_subscriptions_plugin",
        "05_verify_webhooks_plugin",
        "06_verify_test_presets",
        "07_verify_secrets_plugin",
        "08_verify_commerce_plugin",
        "09_verify_rls_isolation",
        "10_verify_rbac_permissions"
      ],
      "default": "09_verify_rls_isolation"
    }
  ]
}
