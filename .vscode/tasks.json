{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "ci: core",
      "type": "shell",
      "command": "node scripts/local-ci.mjs core",
      "group": "test",
      "problemMatcher": []
    },
    {
      "label": "ci: console",
      "type": "shell",
      "command": "node scripts/local-ci.mjs console",
      "group": "test",
      "problemMatcher": []
    },
    {
      "label": "ci: docker",
      "type": "shell",
      "command": "node scripts/local-ci.mjs docker",
      "group": "test",
      "problemMatcher": []
    },
    {
      "label": "ci: all",
      "type": "shell",
      "command": "node scripts/local-ci.mjs all",
      "group": "test",
      "problemMatcher": []
    },
    {
      "label": "ci: secret",
      "type": "shell",
      "command": "gitleaks detect --no-banner --redact",
      "problemMatcher": []
    },
    {
      "label": "dev: stack",
      "dependsOn": ["core: daemon start", "console: dev"],
      "problemMatcher": []
    },
    {
      "label": "core: daemon start",
      "type": "shell",
      "command": "cargo run --bin opn -- worker start -H 127.0.0.1 -p 8765",
      "options": { "cwd": "${workspaceFolder}/core" },
      "isBackground": true,
      "presentation": { "panel": "dedicated" },
      "problemMatcher": []
    },
    {
      "label": "core: daemon stop",
      "type": "shell",
      "command": "cargo run --bin opn -- worker stop",
      "options": { "cwd": "${workspaceFolder}/core" },
      "problemMatcher": []
    },
    {
      "label": "core: check",
      "type": "shell",
      "command": "cargo check --workspace --all-targets",
      "options": { "cwd": "${workspaceFolder}/core" },
      "group": { "kind": "build", "isDefault": true },
      "problemMatcher": ["$rustc"]
    },
    {
      "label": "core: fmt",
      "type": "shell",
      "command": "cargo fmt --all",
      "options": { "cwd": "${workspaceFolder}/core" },
      "problemMatcher": []
    },
    {
      "label": "core: test",
      "type": "shell",
      "command": "cargo test --workspace --lib --bins --tests",
      "options": { "cwd": "${workspaceFolder}/core" },
      "group": { "kind": "test", "isDefault": true },
      "problemMatcher": ["$rustc"]
    },
    {
      "label": "console: install:ci",
      "type": "shell",
      "command": "pnpm install --frozen-lockfile",
      "options": { "cwd": "${workspaceFolder}/console" },
      "problemMatcher": []
    },
    {
      "label": "console: dev",
      "type": "shell",
      "command": "pnpm dev",
      "options": { "cwd": "${workspaceFolder}/console" },
      "isBackground": true,
      "presentation": { "panel": "dedicated" },
      "problemMatcher": []
    },
    {
      "label": "console: dev:desktop",
      "type": "shell",
      "command": "pnpm dev:desktop",
      "options": { "cwd": "${workspaceFolder}/console" },
      "isBackground": true,
      "presentation": { "panel": "dedicated" },
      "problemMatcher": []
    },
    {
      "label": "console: check:type",
      "type": "shell",
      "command": "pnpm check:type",
      "options": { "cwd": "${workspaceFolder}/console" },
      "problemMatcher": ["$tsc"]
    },
    {
      "label": "console: lint",
      "type": "shell",
      "command": "pnpm lint",
      "options": { "cwd": "${workspaceFolder}/console" },
      "problemMatcher": []
    },
    {
      "label": "console: test",
      "type": "shell",
      "command": "pnpm test:unit",
      "options": { "cwd": "${workspaceFolder}/console" },
      "group": "test",
      "problemMatcher": []
    },
    {
      "label": "console: tauri:check",
      "type": "shell",
      "command": "pnpm tauri:check",
      "options": { "cwd": "${workspaceFolder}/console" },
      "problemMatcher": ["$rustc"]
    }
  ]
}
