{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "ci: core",
      "type": "shell",
      "command": "New-Item -ItemType Directory -Force ../.logs | Out-Null; [Console]::OutputEncoding = [Text.Encoding]::UTF8; & { cargo fmt --all -- --check && cargo clippy --workspace --all-targets --quiet -- -D warnings && cargo test --workspace --lib --bins --tests -q } *>&1 | Where-Object { $_ -notmatch '^\\.+(\\s+\\d+/\\d+)?$' } | Tee-Object -FilePath ../.logs/ci-core.log; exit $LASTEXITCODE",
      "options": {
        "cwd": "${workspaceFolder}/core",
        "shell": { "executable": "pwsh", "args": ["-NoProfile", "-Command"] }
      },
      "group": "test",
      "problemMatcher": []
    },
    {
      "label": "ci: console",
      "type": "shell",
      "command": "New-Item -ItemType Directory -Force ../.logs | Out-Null; [Console]::OutputEncoding = [Text.Encoding]::UTF8; & { pnpm install --frozen-lockfile && pnpm release:check && pnpm check && pnpm lint && pnpm test:unit -- --reporter=dot } *>&1 | Tee-Object -FilePath ../.logs/ci-console.log; exit $LASTEXITCODE",
      "options": {
        "cwd": "${workspaceFolder}/console",
        "env": {
          "NO_COLOR": "1",
          "CI": "true",
          "TURBO_OUTPUT_LOGS": "errors-only"
        },
        "shell": { "executable": "pwsh", "args": ["-NoProfile", "-Command"] }
      },
      "group": "test",
      "problemMatcher": ["$tsc"]
    },
    {
      "label": "ci: all",
      "dependsOrder": "sequence",
      "dependsOn": ["ci: core", "ci: console"],
      "group": "test",
      "problemMatcher": []
    },
    {
      "label": "core: daemon start",
      "type": "shell",
      "command": "cargo run --bin opn -- worker start -H 127.0.0.1 -p 8765",
      "options": { "cwd": "${workspaceFolder}/core" },
      "isBackground": true,
      "group": { "kind": "build", "isDefault": true },
      "problemMatcher": []
    },
    {
      "label": "core: daemon stop",
      "type": "shell",
      "command": "cargo run --bin opn -- worker stop",
      "options": { "cwd": "${workspaceFolder}/core" },
      "problemMatcher": []
    },
    {
      "label": "core: check",
      "type": "shell",
      "command": "cargo check --workspace --all-targets",
      "options": { "cwd": "${workspaceFolder}/core" },
      "problemMatcher": []
    },
    {
      "label": "core: fmt",
      "type": "shell",
      "command": "cargo fmt --all",
      "options": { "cwd": "${workspaceFolder}/core" },
      "problemMatcher": []
    },
    {
      "label": "core: test",
      "type": "shell",
      "command": "cargo test --workspace --lib --bins --tests",
      "options": { "cwd": "${workspaceFolder}/core" },
      "group": { "kind": "test", "isDefault": true },
      "problemMatcher": []
    },
    {
      "label": "console: dev",
      "type": "shell",
      "command": "pnpm dev",
      "options": { "cwd": "${workspaceFolder}/console" },
      "isBackground": true,
      "problemMatcher": []
    },
    {
      "label": "console: dev:desktop",
      "type": "shell",
      "command": "pnpm dev:desktop",
      "options": { "cwd": "${workspaceFolder}/console" },
      "isBackground": true,
      "problemMatcher": []
    },
    {
      "label": "console: check:type",
      "type": "shell",
      "command": "pnpm check:type",
      "options": { "cwd": "${workspaceFolder}/console" },
      "problemMatcher": ["$tsc"]
    },
    {
      "label": "console: lint",
      "type": "shell",
      "command": "pnpm lint",
      "options": { "cwd": "${workspaceFolder}/console" },
      "problemMatcher": []
    },
    {
      "label": "console: test",
      "type": "shell",
      "command": "pnpm test:unit",
      "options": { "cwd": "${workspaceFolder}/console" },
      "group": "test",
      "problemMatcher": []
    }
  ]
}
