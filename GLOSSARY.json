{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "version": "1.1.0",
  "description": "Single Source of Truth (SSOT) for canonical domain terminology and file naming conventions across operon, console, and core.",
  "terms": [
    {
      "id": "workspace",
      "term": "workspace",
      "codeIdentifier": {
        "ts": "workspace",
        "rust": "workspace",
        "sql": "workspaces"
      },
      "definition": "Primary isolation boundary for accounts, data, and resources.",
      "forbiddenAliases": [
        "tenant"
      ],
      "note": "Build tooling (`pnpm workspace`, `Cargo workspace`) uses the same word; domain scoping uses `workspace` uniformly across schemas, APIs, and UI."
    },
    {
      "id": "kernel",
      "term": "kernel",
      "codeIdentifier": {
        "ts": "kernel",
        "package": "@operon/kernel"
      },
      "definition": "Host runtime bridge exposing shared reactive context (workspace, session, daemon API) to micro-apps.",
      "forbiddenAliases": []
    },
    {
      "id": "host_shell",
      "term": "host shell",
      "codeIdentifier": {
        "ts": "shell",
        "package": "@operon/shell"
      },
      "definition": "Top-level application frame hosting navigation, layouts, and micro-app modules.",
      "forbiddenAliases": []
    },
    {
      "id": "micro_app",
      "term": "micro-app",
      "codeIdentifier": {
        "ts": "microApp"
      },
      "definition": "Independently developed feature module consuming host capabilities via kernel.",
      "forbiddenAliases": []
    },
    {
      "id": "daemon",
      "term": "daemon",
      "codeIdentifier": {
        "ts": "daemon",
        "rust": "daemon",
        "cli": "opn daemon"
      },
      "definition": "Device-local background service (`opn`, :8765) managing local execution, SQLite state, browser sessions, and schedules.",
      "forbiddenAliases": [
        "local-bridge",
        "localBridge",
        "LocalBridge",
        "Fleet Bridge",
        "Desktop Bridge",
        "opn runner",
        "Runner worker daemon",
        "PILLAR_WORKER",
        "is_valid_worker_name",
        "run_cloud_worker",
        "fleet",
        "Fleet gateway",
        "Sandbox Fleet"
      ]
    },
    {
      "id": "browser_profile",
      "term": "browser profile",
      "codeIdentifier": {
        "ts": "browserProfile",
        "rust": "browser_profile",
        "sql": "browser_profiles"
      },
      "definition": "Saved antidetect browser configuration (fingerprint, proxy, extensions, data directory, local or cloud source).",
      "forbiddenAliases": [
        "cloud fleet",
        "fleet profiles",
        "CLOUD BROWSER FLEET"
      ]
    },
    {
      "id": "browser_session",
      "term": "browser session",
      "codeIdentifier": {
        "ts": "browserSession",
        "rust": "browser_session"
      },
      "definition": "Live running browser process bound to a browser profile.",
      "forbiddenAliases": []
    },
    {
      "id": "browser_driver",
      "term": "browser driver",
      "codeIdentifier": {
        "ts": "browserDriver",
        "rust": "browser_driver"
      },
      "definition": "Downloadable antidetect Chromium binary version used to launch browser sessions.",
      "note": "Internal directory `~/.operon/browser/runtimes/` holds downloaded binaries on disk; UI, REST APIs, and domain identifiers use `browser driver`.",
      "forbiddenAliases": [
        "BrowserRuntimesDialog",
        "browser-runtimes-dialog",
        "useBrowserRuntimesStore",
        "runtimes_btn",
        "runtimes_title",
        "runtimes_desc",
        "runtime_selected",
        "runtime_install_btn",
        "runtime_select_btn",
        "runtime_selected_msg",
        "runtime_deleted_msg"
      ]
    },
    {
      "id": "task",
      "term": "task",
      "codeIdentifier": {
        "ts": "task",
        "rust": "task",
        "sql": "tasks"
      },
      "definition": "Executable automation unit assigned to a browser profile and backed by SQLite.",
      "forbiddenAliases": []
    },
    {
      "id": "schedule",
      "term": "schedule",
      "codeIdentifier": {
        "ts": "schedule",
        "rust": "schedule",
        "sql": "schedules"
      },
      "definition": "Trigger plan defining when a browser profile runs assigned tasks.",
      "forbiddenAliases": []
    },
    {
      "id": "workflow",
      "term": "workflow",
      "codeIdentifier": {
        "ts": "workflow",
        "rust": "workflow",
        "sql": "workflows"
      },
      "definition": "Declarative automation flow graph executed inside a browser session.",
      "forbiddenAliases": []
    },
    {
      "id": "job",
      "term": "job",
      "codeIdentifier": {
        "ts": "job",
        "rust": "job",
        "sql": "jobs"
      },
      "definition": "Queued or active execution run triggered from a task or workflow.",
      "forbiddenAliases": []
    },
    {
      "id": "proxy",
      "term": "proxy",
      "codeIdentifier": {
        "ts": "proxy",
        "rust": "proxy",
        "sql": "proxies"
      },
      "definition": "Network egress endpoint (HTTP, HTTPS, SOCKS5) attached to a browser profile.",
      "forbiddenAliases": []
    },
    {
      "id": "device",
      "term": "device",
      "codeIdentifier": {
        "ts": "device",
        "rust": "device",
        "sql": "devices"
      },
      "definition": "Enrolled host machine running the Operon daemon.",
      "forbiddenAliases": [
        "device fleet",
        "worker fleet",
        "Cloud Fleet"
      ]
    },
    {
      "id": "secret",
      "term": "secret",
      "codeIdentifier": {
        "ts": "secret",
        "rust": "secret",
        "sql": "secrets"
      },
      "definition": "Encrypted credential stored in Vault/device keystore and referenced via `{{secrets@name}}`.",
      "forbiddenAliases": []
    },
    {
      "id": "plugin",
      "term": "plugin",
      "codeIdentifier": {
        "ts": "plugin",
        "sql": "system_plugins"
      },
      "definition": "Capability module gating platform features (`identity`, `operon`, `billing`).",
      "forbiddenAliases": []
    },
    {
      "id": "ci_suite",
      "term": "ci suite",
      "codeIdentifier": {
        "ts": "ciSuite"
      },
      "definition": "Local CI verification group (`core`, `console`, `docker`, `glossary`) orchestrated by `scripts/local-ci.mjs`.",
      "forbiddenAliases": []
    },
    {
      "id": "ci_step",
      "term": "ci step",
      "codeIdentifier": {
        "ts": "ciStep"
      },
      "definition": "Single command stage within a `ci suite` delimited by `> [<step>] <command>` in local CI output.",
      "forbiddenAliases": []
    },
    {
      "id": "ci_log",
      "term": "ci log",
      "codeIdentifier": {
        "ts": "ciLog"
      },
      "definition": "UTF-8 output log `~/.operon/logs/ci/ci-<suite>.log` and `~/.operon/logs/ci/.ci-cache.json` produced by `scripts/local-ci.mjs`.",
      "forbiddenAliases": []
    }
  ],
  "namingConventions": {
    "console": {
      "sourceFiles": "kebab-case",
      "extensions": [".ts", ".tsx", ".js", ".mjs", ".vue", ".css", ".scss", ".json"],
      "exemptPaths": [
        "/locales/langs/",
        "/migrations/meta/",
        "packages/@core/ui-kit/shadcn-ui/src/ui/"
      ],
      "exemptBasenames": [
        "README.md",
        "LICENSE",
        "CHANGELOG.md",
        "AGENTS.md",
        "CONTRIBUTING.md",
        "CONSTRAINTS.md",
        "tsconfig",
        "package.json",
        "components.json",
        "turbo.json"
      ]
    },
    "core": {
      "sourceFiles": "snake_case",
      "extensions": [".rs"]
    }
  }
}
