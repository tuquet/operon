#!/usr/bin/env bash
# ==============================================================================
# Operon CLI Smart Shim (POSIX Shell: Linux / macOS / WSL)
# Auto-detects native opn/tq or delegates seamlessly to daemon container
# ==============================================================================

if command -v opn >/dev/null 2>&1 && [ "$(command -v opn)" != "$0" ]; then
    exec opn "$@"
elif command -v tq >/dev/null 2>&1; then
    exec tq "$@"
else
    if docker ps --filter "name=daemon" --filter "status=running" -q | grep -q .; then
        exec docker exec -i daemon tq "$@"
    else
        echo "Error: opn/tq binary not found on host, and container 'daemon' is not running." >&2
        echo "Hint: Start the core stack first:  docker compose up -d" >&2
        exit 1
    fi
fi
